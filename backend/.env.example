PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================
# DATABASE CONFIGURATION
# ==============================================================
# Option 1: Aiven Free Cloud MySQL (Recommended) - Paste Full Service URI:
# DATABASE_URL=mysql://avnadmin:your_password@your-mysql-service.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option 2: Aiven / Custom MySQL Individual Parameters:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=aashray_db
DB_PORT=3306
DB_SSL=false

# Option 3: Local SQLite embedded fallback (zero setup needed):
# DB_DRIVER=sqlite

# ==============================================================
# CLOUDINARY CONFIGURATION (Free 25GB Cloud Image Storage)
# ==============================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================
# MONGODB CONFIGURATION (All Form Data: Meals, Medicine, Volunteers, Contact)
# ==============================================================
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aashray?retryWrites=true&w=majority
